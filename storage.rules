rules_version = '2';

// 🎃 Haunted Kiosk — Firebase Storage rules
// Layout:  ghouls/{uid}/{jobId}/
//   selfie.jpg · avatar.png · avatar-branded.jpg      ← browser (images ≤ 10 MB)
//   video-branded.mp4 | video-branded.webm             ← browser (logo-burned video ≤ 60 MB)
//   meta.json                                          ← browser (scene, caption, token counts ≤ 100 KB)
//   video.mp4                                          ← Vercel function with the Admin SDK (bypasses rules)
// Each anonymous user can only read, write and delete inside their own folder.
// The /admin area lists and deletes everything through the Admin SDK on the server.
service firebase.storage {
  match /b/{bucket}/o {
    match /ghouls/{uid}/{jobId}/{fileName} {
      function isOwner() {
        return request.auth != null && request.auth.uid == uid;
      }
      function isImage() {
        return request.resource.contentType.matches('image/.*')
          && request.resource.size < 10 * 1024 * 1024;
      }
      function isBrandedVideo() {
        return fileName.matches('video-branded\\.(mp4|webm)')
          && request.resource.contentType.matches('video/(mp4|webm)')
          && request.resource.size < 60 * 1024 * 1024;
      }
      function isMeta() {
        return fileName == 'meta.json'
          && request.resource.contentType == 'application/json'
          && request.resource.size < 100 * 1024;
      }

      allow read, delete: if isOwner();
      allow create, update: if isOwner() && (isImage() || isBrandedVideo() || isMeta());
    }

    // Pickup card for one finished run. Anyone with the code can read the photo and video URLs.
    // Only a signed-in guest can publish a card, and only under a 6-character code.
    match /codes/{code} {
      allow read: if true;
      allow create, update: if request.auth != null
        && code.matches('^[23456789ABCDEFGHJKLMNPQRSTUVWXYZ]{6}\\.json$')
        && request.resource.contentType == 'application/json'
        && request.resource.size < 8 * 1024;
      allow delete: if request.auth != null
        && code.matches('^[23456789ABCDEFGHJKLMNPQRSTUVWXYZ]{6}\\.json$');
    }

    // Everything else is locked.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
