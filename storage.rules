rules_version = '2';

// 🎃 Haunted Kiosk — Firebase Storage rules
// Layout:  ghouls/{uid}/{jobId}/
//   selfie.jpg · avatar.png · avatar-branded.jpg      ← browser (images ≤ 10 MB)
//   video-branded.mp4 | video-branded.webm             ← browser (logo-burned video ≤ 60 MB)
//   meta.json                                          ← browser (scene, caption, token counts ≤ 100 KB)
//   video.mp4                                          ← Vercel function with the Admin SDK (bypasses rules)
// Each anonymous user can only read, write and delete inside their own folder.
// The /admin area lists and deletes everything through the Admin SDK on the server.
service firebase.storage {
  match /b/{bucket}/o {
    match /ghouls/{uid}/{jobId}/{fileName} {
      function isOwner() {
        return request.auth != null && request.auth.uid == uid;
      }
      function isImage() {
        return request.resource.contentType.matches('image/.*')
          && request.resource.size < 10 * 1024 * 1024;
      }
      function isBrandedVideo() {
        return fileName.matches('video-branded\\.(mp4|webm)')
          && request.resource.contentType.matches('video/(mp4|webm)')
          && request.resource.size < 60 * 1024 * 1024;
      }
      function isMeta() {
        return fileName == 'meta.json'
          && request.resource.contentType == 'application/json'
          && request.resource.size < 100 * 1024;
      }

      allow read, delete: if isOwner();
      allow create, update: if isOwner() && (isImage() || isBrandedVideo() || isMeta());
    }

    // Pickup card for one run: codes/{CODE}.json.
    //  • Nobody reads or lists cards through Storage. The /r/CODE page reads one card through
    //    GET /api/pickup?code=CODE (Admin SDK), so the folder can't be enumerated.
    //  • A signed-in guest can create a NEW card (never take over an existing code) and stamps it
    //    with metadata.owner = their uid. Only that guest can update or delete it.
    //  • Cards written by the server (/admin backfill) carry the job's uid as owner too.
    match /codes/{code} {
      function validCode() {
        return code.matches('^[23456789ABCDEFGHJKLMNPQRSTUVWXYZ]{6}\\.json$');
      }
      function validCard() {
        return request.resource.contentType == 'application/json'
          && request.resource.size < 8 * 1024
          && request.resource.metadata.owner == request.auth.uid;
      }
      allow read: if false;
      allow create: if request.auth != null && validCode() && resource == null && validCard();
      allow update: if request.auth != null && validCode()
        && resource.metadata.owner == request.auth.uid && validCard();
      allow delete: if request.auth != null && resource.metadata.owner == request.auth.uid;
    }

    // Everything else is locked.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
