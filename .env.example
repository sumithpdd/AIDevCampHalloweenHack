# ─────────────────────────────────────────────────────────────
# 🎃 AI DevCamp Halloween Hack — environment variables
# Copy to .env.local for local dev:   cp .env.example .env.local
# On Vercel, add the same keys in Project → Settings → Environment Variables
# ─────────────────────────────────────────────────────────────

# ---- Browser (public) — Firebase web app config --------------
# Firebase console → Project settings → General → Your apps → Web app → SDK setup
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# App Check. Firebase AI Logic rejects Gemini calls without a valid token.
# Localhost: create a debug token (App Check → Apps → Manage debug tokens) and paste it here.
# Do not set this on Vercel. Production uses the reCAPTCHA Enterprise site key instead.
VITE_APPCHECK_DEBUG_TOKEN=
# reCAPTCHA Enterprise site key for a shared URL. Include localhost and your Vercel domain.
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=

# Model IDs used in the browser through Firebase AI Logic
VITE_PROMPT_MODEL=gemini-3.8-flash
VITE_IMAGE_MODEL=gemini-3.1-flash-image

# ---- Server only (Vercel Functions) — NEVER prefix with VITE_ ----
# Google AI Studio key → https://aistudio.google.com/apikey  (used for Gemini Omni video)
GEMINI_API_KEY=
# Gemini Omni model. Docs list "gemini-omni-1.1-flash"; the Formula E lab used
# "gemini-omni-1.1-flash-preview". Use whichever your key has access to.
OMNI_MODEL=gemini-omni-1.1-flash

# Firebase service account JSON, base64-encoded on ONE line:
#   macOS/Linux:  base64 -i service-account.json | tr -d '\n'
#   PowerShell:   [Convert]::ToBase64String([IO.File]::ReadAllBytes("service-account.json"))
FIREBASE_SERVICE_ACCOUNT_BASE64=
# Same bucket as VITE_FIREBASE_STORAGE_BUCKET
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app

# ---- Admin area (/admin) — server only -------------------------
# Password for the admin page (6+ chars). Server only. Generate one:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
ADMIN_SECRET=
